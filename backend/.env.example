# Google Gemini API key — get one from https://aistudio.google.com/app/apikey
# Optional: without it the app still starts, but extraction/Q&A return 503.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# Comma-separated list of origins allowed to call this API (CORS)
ALLOWED_ORIGINS=http://localhost:3000

# Max upload size in bytes for transcript files (default 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# SQLite file for cross-meeting memory
DATABASE_PATH=data/meetings.db

# Grounding & guardrails
GROUNDING_THRESHOLD=0.8
ENABLE_LLM_VERIFIER=false
REDACT_PII=true

# Protect /api/* with a shared key (clients send X-API-Key) and rate-limit per IP
API_KEY=
RATE_LIMIT_PER_MINUTE=60

# Approved "github_issue" actions are created here. Leave empty for dry runs.
ACTIONS_GITHUB_TOKEN=
ACTIONS_GITHUB_REPO=
